datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

enum Role {
  ADMIN
  OPERATOR
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         Role       @default(ADMIN)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]

  @@map("users")
}

model Service {
  id             String      @id @default(cuid())
  name           String
  containerName  String      @unique
  containerId    String?
  image          String
  internalPort   Int
  status         String      @default("running") // running, stopped, restarting, error
  isActive       Boolean     @default(true)
  isDefault      Boolean     @default(false)
  notes          String?
  sourceType     String      @default("IMAGE") // IMAGE, GITHUB
  gitRepoUrl     String?
  gitBranch      String?     @default("main")
  dockerfilePath String?     @default("Dockerfile")
  envVars        String?     @db.Text
  webhookSecret  String?
  lastBuiltAt    DateTime?
  buildStatus    String?     @default("idle") // idle, cloning, building, success, failed
  buildLogs      String?     @db.Text
  restartPolicy  String?     @default("unless-stopped")
  memoryLimitMb  Int?
  cpuLimit       Float?
  command        String?
  volumes        String?
  network        String?     @default("proxy-net")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  domains        Domain[]
  buildLogsList  BuildLog[]

  @@index([isActive])
  @@index([isDefault])
  @@map("services")
}

model Domain {
  id              String   @id @default(cuid())
  domainName      String   @unique
  serviceId       String
  service         Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  targetContainer String?  // Single container name OR JSON array of targets for Load Balancing
  targetPort      Int?
  healthCheckPath String?
  loadBalanceMode String?  @default("round_robin")
  isActive        Boolean  @default(true)
  sslStatus       String   @default("cloudflare_proxied") // cloudflare_proxied, origin_ready, pending
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([serviceId])
  @@index([isActive])
  @@map("domains")
}

model ProxyConfiguration {
  id           String   @id @default(cuid())
  version      Int      @unique
  contentYaml  String   @db.Text
  appliedAt    DateTime @default(now())
  appliedBy    String
  status       String   @default("applied") // applied, generated, failed
  errorMessage String?

  @@index([appliedAt])
  @@map("proxy_configurations")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName   String
  action     String
  entityType String   // SERVICE, DOMAIN, PROXY, CONTAINER, SETTINGS, AUTH
  entityId   String?
  details    String   @db.Text
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType])
  @@map("audit_logs")
}

model BuildLog {
  id         String    @id @default(cuid())
  serviceId  String
  service    Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  status     String    // cloning, building, success, failed
  logs       String    @db.Text
  gitCommit  String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([serviceId])
  @@map("build_logs")
}

model AppSettings {
  id                       String   @id @default("default")
  mainDomain               String   @default("meudominio.com.br")
  originServerIp           String   @default("127.0.0.1")
  originHttpsPort          Int      @default(443)
  cloudflareSslMode        String   @default("Full (strict)")
  dockerSocketPath         String   @default("/var/run/docker.sock")
  traefikDynamicConfigPath String   @default("./traefik/dynamic/dynamic_conf.yml")
  autoApplyTraefik         Boolean  @default(true)
  defaultFallbackEnabled   Boolean  @default(true)
  updatedAt                DateTime @updatedAt

  @@map("app_settings")
}
