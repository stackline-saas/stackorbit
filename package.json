{
  "name": "stackorbit",
  "version": "1.0.0",
  "packageManager": "pnpm@9.12.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:backend": "pnpm --filter @stackorbit/backend dev",
    "dev:worker": "pnpm --filter @stackorbit/worker dev",
    "dev:frontend": "pnpm --filter @stackorbit/frontend dev",
    "build": "pnpm --filter @stackorbit/shared build && pnpm --filter @stackorbit/database build && pnpm -r --filter=!@stackorbit/shared --filter=!@stackorbit/database build",
    "db:generate": "pnpm --filter @stackorbit/database prisma:generate",
    "db:push": "pnpm --filter @stackorbit/database prisma:push",
    "db:migrate": "pnpm --filter @stackorbit/database prisma:migrate",
    "db:seed": "pnpm --filter @stackorbit/database prisma:seed",
    "test:backend": "pnpm --filter @stackorbit/backend test",
    "lint": "pnpm -r lint"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "bcryptjs",
      "ssh2"
    ]
  },
  "devDependencies": {
    "puppeteer-core": "^25.16.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2"
  }
}
