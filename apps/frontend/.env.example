# Porta do servidor da aplicação
PORT=3000

# Conexão com o banco de dados PostgreSQL (usado pelo Prisma ORM)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/domainmanager?schema=public"

# Caminho do Socket do Docker Engine
# Em ambientes Linux / Docker: /var/run/docker.sock
DOCKER_SOCKET_PATH="/var/run/docker.sock"

# Caminho do arquivo de configuração dinâmica consumido pelo Traefik
TRAEFIK_DYNAMIC_CONFIG_PATH="./traefik/dynamic/dynamic_conf.yml"

# Configuração Cloudflare Origin e Domínio Principal
MAIN_DOMAIN="bla.com.br"
ORIGIN_SERVER_IP="198.51.100.25"
ORIGIN_HTTPS_PORT=443
CLOUDFLARE_SSL_MODE="Full (strict)"

# Credenciais iniciais do administrador
ADMIN_EMAIL="admin@bla.com.br"
ADMIN_PASSWORD="admin123"
