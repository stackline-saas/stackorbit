# ==============================================================================
# STACKORBIT - CONFIGURAÇÃO DE AMBIENTE (PRODUÇÃO)
# ==============================================================================

# Versão da aplicação (tag GHCR)
APP_VERSION=v0.1.0

# Porta externa do painel web/API (Padrão: 8088)
PORT=8088

# Banco de Dados PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=altere_para_uma_senha_muito_segura
POSTGRES_DB=domainmanager

# Chave de segurança para sessões JWT (mínimo 32 caracteres)
JWT_SECRET=gere_uma_chave_secreta_aleatoria_com_openssl_rand_hex_32

# Configuração do Docker
DOCKER_NETWORK=proxy-net
