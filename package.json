{
  "name": "docker-domain-manager-monorepo",
  "version": "1.0.0",
  "packageManager": "pnpm@9.12.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:backend": "pnpm --filter @docker-domain/backend dev",
    "dev:worker": "pnpm --filter @docker-domain/worker dev",
    "dev:frontend": "pnpm --filter @docker-domain/frontend dev",
    "build": "pnpm --filter @docker-domain/shared build && pnpm --filter @docker-domain/database build && pnpm -r --filter=!@docker-domain/shared --filter=!@docker-domain/database build",
    "db:generate": "pnpm --filter @docker-domain/database prisma:generate",
    "db:push": "pnpm --filter @docker-domain/database prisma:push",
    "db:migrate": "pnpm --filter @docker-domain/database prisma:migrate",
    "db:seed": "pnpm --filter @docker-domain/database prisma:seed",
    "test:backend": "pnpm --filter @docker-domain/backend test",
    "lint": "pnpm -r lint"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "bcryptjs",
      "ssh2"
    ]
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.2"
  }
}
