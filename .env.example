# ==============================================================================
# VARIÁVEIS DE AMBIENTE - DOCKER DOMAIN MANAGER (PNPM MONOREPO + POSTGRESQL)
# ==============================================================================

# Porta HTTP do painel / API
PORT=3000
NODE_ENV=production

# Chave secreta para assinatura dos tokens JWT (Substitua por uma string forte)
JWT_SECRET=substitua-por-um-segredo-jwt-forte-e-aleatorio-2026

# Banco de Dados PostgreSQL
# Local/Docker Compose:
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/domainmanager?schema=public"
# Ou servidor remoto (ex: 192.168.0.7):
# DATABASE_URL="postgresql://infopulse:infopulse@192.168.0.7:5432/infopulse?schema=dockerdomain"

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=domainmanager

# Socket do Docker Daemon no host ou conexão remota SSH
# No Linux/VPS: /var/run/docker.sock
# No Windows/Dev remoto: ssh://usuario@192.168.0.7 ou //./pipe/docker_engine
DOCKER_SOCKET_PATH=/var/run/docker.sock
# DOCKER_HOST=ssh://usuario@192.168.0.7

# Caminhos dos arquivos de configuração compartilhados com o Traefik
TRAEFIK_DYNAMIC_CONFIG_PATH=/app/traefik/dynamic/dynamic_conf.yml
TRAEFIK_CERTS_DIR=/app/traefik/certs

# Fila BullMQ com Redis
REDIS_URL=redis://redis:6379

# Rede Docker compartilhada para os containers
DOCKER_NETWORK=proxy-net
