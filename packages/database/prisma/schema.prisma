datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

enum Role {
  ADMIN
  OPERATOR
}

enum DockerHostType {
  LOCAL_SOCKET
  SSH
  TCP_TLS
  EDGE_AGENT
}

enum DockerHostStatus {
  ONLINE
  OFFLINE
  CONNECTING
  ERROR
}

enum ProjectType {
  STANDALONE
  SWARM
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         Role       @default(ADMIN)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]

  @@map("users")
}

model Service {
  id             String      @id @default(cuid())
  name           String
  containerName  String      @unique
  containerId    String?
  image          String
  internalPort   Int
  status         String      @default("running") // running, stopped, restarting, error
  isActive       Boolean     @default(true)
  isDefault      Boolean     @default(false)
  notes          String?
  sourceType     String      @default("IMAGE") // IMAGE, GITHUB
  gitRepoUrl     String?
  gitBranch      String?     @default("main")
  dockerfilePath String?     @default("Dockerfile")
  envVars        String?     @db.Text
  webhookSecret  String?
  lastBuiltAt    DateTime?
  buildStatus    String?     @default("idle") // idle, cloning, building, success, failed
  buildLogs      String?     @db.Text
  restartPolicy  String?     @default("unless-stopped")
  memoryLimitMb  Int?
  cpuLimit       Float?
  command        String?
  volumes        String?
  network        String?     @default("proxy-net")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  projectId      String?
  project        Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  dockerHostId   String?
  dockerHost     DockerHost? @relation(fields: [dockerHostId], references: [id], onDelete: SetNull)
  domains        Domain[]
  buildLogsList  BuildLog[]

  @@index([isActive])
  @@index([isDefault])
  @@index([projectId])
  @@index([dockerHostId])
  @@map("services")
}

model Project {
  id                    String        @id @default(cuid())
  name                  String        @unique
  slug                  String        @unique
  description           String?
  type                  ProjectType   @default(STANDALONE)
  isDefault             Boolean       @default(false)
  mainDomain            String?       @default("meudominio.com.br")
  originServerIp        String?       @default("127.0.0.1")
  originHttpsPort       Int?          @default(443)
  cloudflareSslMode     String?       @default("Full (strict)")
  autoApplyTraefik      Boolean?      @default(true)
  defaultFallbackEnabled Boolean?     @default(true)
  swarmJoinTokenManager String?
  swarmJoinTokenWorker  String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  hosts                 DockerHost[]
  services              Service[]
  gitProviders          GitProvider[]

  @@map("projects")
}

model DockerHost {
  id             String           @id @default(cuid())
  name           String
  projectId      String
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type           DockerHostType   @default(SSH)
  status         DockerHostStatus @default(OFFLINE)
  endpointUrl    String           // Ex: "ssh://user@203.0.113.10:22", "tcp://ip:2376", ou "/var/run/docker.sock"
  sshUser        String?
  sshKey         String?          @db.Text
  sshPassword    String?
  tlsCert        String?          @db.Text
  tlsKey         String?          @db.Text
  tlsCa          String?          @db.Text
  agentToken     String?          @unique
  isDefault      Boolean          @default(false)
  isSwarmManager Boolean          @default(false)
  swarmNodeId    String?
  cpuUsage       Float?
  memUsage       Float?
  dockerVersion  String?
  osInfo         String?
  containersCount Int?            @default(0)
  lastPingAt     DateTime?
  errorMessage   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  services       Service[]

  @@index([projectId])
  @@map("docker_hosts")
}

model Domain {
  id              String   @id @default(cuid())
  domainName      String   @unique
  serviceId       String
  service         Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  targetContainer String?  // Single container name OR JSON array of targets for Load Balancing
  targetPort      Int?
  healthCheckPath String?
  loadBalanceMode String?  @default("round_robin")
  isActive        Boolean  @default(true)
  sslStatus       String   @default("cloudflare_proxied") // cloudflare_proxied, origin_ready, pending
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([serviceId])
  @@index([isActive])
  @@map("domains")
}

model ProxyConfiguration {
  id           String   @id @default(cuid())
  version      Int      @unique
  contentYaml  String   @db.Text
  appliedAt    DateTime @default(now())
  appliedBy    String
  status       String   @default("applied") // applied, generated, failed
  errorMessage String?

  @@index([appliedAt])
  @@map("proxy_configurations")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName   String
  action     String
  entityType String   // SERVICE, DOMAIN, PROXY, CONTAINER, SETTINGS, AUTH
  entityId   String?
  details    String   @db.Text
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType])
  @@map("audit_logs")
}

model BuildLog {
  id         String    @id @default(cuid())
  serviceId  String
  service    Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  status     String    // cloning, building, success, failed
  logs       String    @db.Text
  gitCommit  String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([serviceId])
  @@map("build_logs")
}

model AppSettings {
  id                       String   @id @default("default")
  mainDomain               String   @default("meudominio.com.br")
  originServerIp           String   @default("127.0.0.1")
  originHttpsPort          Int      @default(443)
  cloudflareSslMode        String   @default("Full (strict)")
  dockerSocketPath         String   @default("/var/run/docker.sock")
  traefikDynamicConfigPath String   @default("./traefik/dynamic/dynamic_conf.yml")
  autoApplyTraefik         Boolean  @default(true)
  defaultFallbackEnabled   Boolean  @default(true)
  updatedAt                DateTime @updatedAt

  @@map("app_settings")
}

model GitProvider {
  id           String    @id @default(cuid())
  projectId    String?
  project      Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  provider     String    // "github", "gitlab", "bitbucket"
  name         String    // e.g. "victor" ou "Meu GitHub"
  accountName  String?   // GitHub login handle
  accountUrl   String?
  avatarUrl    String?
  accessToken  String    @db.Text
  refreshToken String?   @db.Text
  tokenType    String    @default("oauth") // "oauth" | "pat"
  scopes       String?   // "repo,read:user,admin:repo_hook"
  metadata     String?   @db.Text
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([provider])
  @@index([isActive])
  @@index([projectId])
  @@map("git_providers")
}
